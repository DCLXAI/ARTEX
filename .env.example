# Docker 部署配置（复制为 .env）
ARTEX_TAG=latest
POSTGRES_USER=artex
POSTGRES_PASSWORD=change-me-please
POSTGRES_DB=artex

# GitHub Release 更新令牌（可选，仅后端读取；DCLXAI/ARTEX 为公开仓库，令牌只用于提高接口限额，需 Contents: read）
ARTEX_UPDATE_GITHUB_TOKEN=

# LLM（二选一或都填；也可留空到 UI 里配）
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
ARTEX_LLM_PROVIDER=
ARTEX_LLM_MODEL=
ARTEX_LLM_BASE_URL=
ARTEX_LLM_PROXY=
